<% content_for(:status_context) { "SZCZEGÓŁY BITWY // #{@event.name.upcase}" } %>

<div class="max-w-6xl mx-auto">
  <div class="bg-hud-bg-panel border border-hud-border rounded p-6 mb-6 hud-panel hud-blueprint-grid">
    <div class="flex justify-between items-start">
      <div>
        <h1 class="font-hud-heading text-2xl font-bold text-hud-green hud-glow uppercase">
          <%= @event.name %>
        </h1>
        <p class="text-hud-text-dim mt-1 text-sm">
          <%= I18n.l(@event.date, format: :long) %> &middot;
          <%= @event.game_system_label %><% unless @event.themed? %> &middot;
          limit <%= @event.point_cap %> <%= @event.point_value_label %><% end %>
        </p>
      </div>
      <span class="hud-stamp <%= case @event.status
            when 'upcoming' then 'hud-stamp-amber'
            when 'active' then 'hud-stamp-green'
            when 'completed' then 'hud-stamp-muted'
            end %>">
        <%= { "upcoming" => "Nadchodzące", "active" => "Aktywne", "completed" => "Zakończone" }[@event.status] %>
      </span>
    </div>

    <% show_eras = @event.event_era_restrictions.any? %>
    <% show_factions = !@event.themed? && @event.event_faction_restrictions.any? %>
    <% if show_eras || show_factions %>
      <div class="mt-4 pt-4" style="border-top: 1px dashed rgba(0, 255, 65, 0.15);">
        <% if show_eras %>
          <p class="text-sm text-hud-text-dim">
            <span class="text-hud-text-muted uppercase text-xs tracking-wider">Ery:</span>
            <%= @event.event_era_restrictions.map(&:era_name).join(", ") %>
          </p>
        <% end %>
        <% if show_factions %>
          <p class="text-sm text-hud-text-dim mt-1">
            <span class="text-hud-text-muted uppercase text-xs tracking-wider">Frakcje:</span>
            <%= @event.event_faction_restrictions.map(&:faction_name).join(", ") %>
          </p>
        <% end %>
      </div>
    <% end %>

    <% if @event.notes.present? %>
      <div class="mt-4 pt-4" style="border-top: 1px dashed rgba(0, 255, 65, 0.15);">
        <p class="text-sm text-hud-text-dim whitespace-pre-wrap"><%= @event.notes %></p>
      </div>
    <% end %>
  </div>

  <%# === Shared army list panel === %>
  <% if @event.shared_army_list? && @shared_army_list %>
    <div class="bg-hud-bg-panel border border-hud-green/40 rounded p-5 mb-6 hud-panel">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 mb-4">
        <div>
          <h2 class="font-hud-heading text-xl font-bold text-hud-green uppercase">
            Wspólna lista (co-op)
          </h2>
          <p class="text-sm text-hud-text-dim mt-1">
            <%= @shared_army_list.active_participants.count %> uczestników &middot;
            <%= @shared_army_list.total_points %> / <%= @shared_army_list.effective_point_cap %>
            <%= @event.point_value_label %> &middot;
            tech: <%= @shared_army_list.tech_base_label %> &middot;
            <span class="<%= { 'draft' => 'text-hud-amber', 'submitted' => 'text-hud-green', 'inactive' => 'text-hud-text-muted' }[@shared_army_list.status] %>">
              <%= { 'draft' => 'wersja robocza', 'submitted' => 'zgłoszona', 'inactive' => 'nieaktywna' }[@shared_army_list.status] %>
            </span>
          </p>
        </div>

        <% if @shared_current_participant.present? %>
          <%= link_to "Otwórz listę",
              event_army_list_path(@event, @shared_army_list),
              class: "inline-block hud-btn-primary px-6 py-3 rounded text-sm no-underline whitespace-nowrap" %>
        <% end %>
      </div>

      <% if @shared_current_participant.blank? %>
        <%= render partial: "shared_army_lists/join_form", locals: { event: @event } %>
      <% end %>
    </div>
  <% end %>

  <%# === VS Banner for themed events === %>
  <% if @event.themed? %>
    <div class="bg-hud-bg-panel border border-hud-amber/40 rounded p-4 mb-6 hud-panel">
      <div class="grid gap-4 items-center" style="grid-template-columns: <%= @event_sides.map { '1fr' }.join(' auto ') %>;">
        <% @event_sides.each_with_index do |side, i| %>
          <% if i > 0 %>
            <div class="text-center">
              <span class="font-hud-heading text-xl font-bold text-hud-amber" style="text-shadow: 0 0 8px rgba(245, 158, 11, 0.5);">VS</span>
            </div>
          <% end %>
          <div class="text-center">
            <h3 class="font-hud-heading text-lg font-bold text-hud-green uppercase"><%= side.name %></h3>
            <p class="text-sm text-hud-text-dim mt-1">
              <%= side.point_cap %> <%= @event.point_value_label %> &middot;
              <%= side.player_count %><%= side.max_players ? " / #{side.max_players}" : "" %> graczy
            </p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# === Draft lists === %>
  <% if @my_drafts.any? && !@event.shared_army_list? %>
    <div class="mb-6">
      <h2 class="font-hud-heading text-lg font-semibold text-hud-amber mb-3 uppercase tracking-wider flex items-center gap-2">
        <span class="inline-block w-2 h-2 bg-hud-amber rounded-full animate-pulse"></span>
        Twoje wersje robocze
      </h2>
      <div class="space-y-2">
        <% @my_drafts.each do |draft| %>
          <%= link_to event_army_list_path(@event, draft),
              class: "block bg-hud-bg-panel border border-hud-amber/40 rounded p-4 hover:border-hud-amber hover:bg-hud-bg-panel-hover transition no-underline hud-accent-amber" do %>
            <div class="flex justify-between items-center">
              <div>
                <span class="font-medium text-hud-amber"><%= draft.player_name %></span>
                <% if @event.themed? && draft.event_side %>
                  <span class="text-xs text-hud-text-muted ml-2">[<%= draft.event_side.name %>]</span>
                <% end %>
                <span class="text-sm text-hud-text-dim ml-2">
                  <%= draft.army_list_items.size %> jednostek &middot;
                  <%= draft.total_points %> / <%= draft.effective_point_cap %> <%= @event.point_value_label %><% if draft.bonus_points != 0 %>
                    <span class="text-hud-amber">(<%= draft.bonus_points >= 0 ? "+" : "" %><%= draft.bonus_points %>)</span>
                  <% end %>
                </span>
              </div>
              <span class="hud-stamp hud-stamp-amber">Wersja robocza</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# === Inactive lists === %>
  <% if @my_inactive.any? && !@event.shared_army_list? %>
    <div class="mb-6">
      <h2 class="font-hud-heading text-lg font-semibold text-hud-text-muted mb-3 uppercase tracking-wider">
        Twoje nieaktywne listy
      </h2>
      <div class="space-y-2">
        <% @my_inactive.each do |list| %>
          <%= link_to event_army_list_path(@event, list),
              class: "block bg-hud-bg-panel border border-hud-border rounded p-4 hover:border-hud-border-bright hover:bg-hud-bg-panel-hover transition no-underline" do %>
            <div class="flex justify-between items-center">
              <div>
                <span class="font-medium text-hud-text-muted"><%= list.player_name %></span>
                <% if @event.themed? && list.event_side %>
                  <span class="text-xs text-hud-text-dim ml-2">[<%= list.event_side.name %>]</span>
                <% end %>
                <span class="text-sm text-hud-text-dim ml-2">
                  <%= list.army_list_items.size %> jednostek &middot;
                  <%= list.total_points %> / <%= list.effective_point_cap %> <%= @event.point_value_label %><% if list.bonus_points != 0 %>
                    <span class="text-hud-amber">(<%= list.bonus_points >= 0 ? "+" : "" %><%= list.bonus_points %>)</span>
                  <% end %>
                </span>
              </div>
              <span class="hud-stamp hud-stamp-muted">Nieaktywna</span>
            </div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# === Create list button === %>
  <% if @event.status != "completed" && !@event.shared_army_list? %>
    <div class="mb-6">
      <%= link_to new_event_army_list_path(@event),
          class: "inline-block hud-btn-primary px-6 py-3 rounded text-sm no-underline" do %>
        + UTWÓRZ LISTĘ
      <% end %>
    </div>
  <% end %>

  <%# === Submitted lists === %>
  <% if @event.themed? %>
    <%# Themed: side-by-side columns %>
    <% if @submitted_lists.any? || @event_sides.any? { |s| s.max_players.present? } %>
      <h2 class="font-hud-heading text-xl font-semibold text-hud-green mb-4 uppercase tracking-wider">
        Zgłoszone listy
      </h2>
      <%# grid-cols-1 on mobile, side count columns on md+ %>
      <div class="grid grid-cols-1 gap-6 mb-6 <%= { 2 => 'md:grid-cols-2', 3 => 'md:grid-cols-3', 4 => 'md:grid-cols-4' }[@event_sides.size] %>">
        <% @event_sides.each do |side| %>
          <div>
            <h3 class="font-hud-heading text-base font-semibold text-hud-green mb-3 uppercase tracking-wider">
              <%= side.name %> &middot;
              <span class="text-hud-text-dim font-normal normal-case"><%= side.per_player_point_cap %> <%= @event.point_value_label %> / gracz</span>
            </h3>
            <div class="space-y-3">
              <% side_lists = @submitted_by_side[side.id] || [] %>
              <% side_lists.each do |list| %>
                <%= link_to event_army_list_path(@event, list),
                    class: "block bg-hud-bg-panel border border-hud-border rounded p-4 hover:border-hud-border-bright hover:bg-hud-bg-panel-hover transition no-underline" do %>
                  <div>
                    <span class="font-medium text-hud-green"><%= list.player_name %></span>
                    <span class="text-sm text-hud-text-dim ml-2">
                      <%= list.army_list_items.size %> jednostek &middot;
                      <%= list.total_points %> <%= @event.point_value_label %>
                    </span>
                  </div>
                  <span class="text-xs text-hud-text-muted">
                    Zgłoszono <%= time_ago_in_words(list.submitted_at) %> temu
                  </span>
                <% end %>
              <% end %>
              <% if side.max_players.present? %>
                <% empty_slots = side.max_players - side.player_count %>
                <% if empty_slots > 0 %>
                  <div class="border border-dashed border-hud-border rounded p-4 text-center text-sm text-hud-text-muted">
                    <%= empty_slots %> wolne <%= empty_slots == 1 ? "miejsce" : "miejsca" %>
                  </div>
                <% end %>
              <% end %>
              <% if side_lists.empty? && (side.max_players.nil? || side.max_players - side.player_count <= 0) %>
                <p class="text-sm text-hud-text-muted italic">Brak zgłoszonych list</p>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <%# Standard: flat list %>
    <% if @submitted_lists.any? %>
      <h2 class="font-hud-heading text-xl font-semibold text-hud-green mb-4 uppercase tracking-wider">
        Zgłoszone listy
      </h2>
      <div class="space-y-3">
        <% @submitted_lists.each do |list| %>
          <%= link_to event_army_list_path(@event, list),
              class: "block bg-hud-bg-panel border border-hud-border rounded p-4 hover:border-hud-border-bright hover:bg-hud-bg-panel-hover transition no-underline" do %>
            <div class="flex justify-between items-center">
              <div>
                <span class="font-medium text-hud-green"><%= list.player_name %></span>
                <span class="text-sm text-hud-text-dim ml-2">
                  <%= list.army_list_items.size %> jednostek &middot;
                  <%= list.total_points %> <%= @event.point_value_label %>
                </span>
              </div>
              <span class="text-xs text-hud-text-muted">
                Zgłoszono <%= time_ago_in_words(list.submitted_at) %> temu
              </span>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
