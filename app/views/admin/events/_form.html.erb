<%= form_with model: [:admin, event], class: "space-y-6", data: { controller: "themed-event" } do |form| %>
  <% if event.errors.any? %>
    <div class="p-4 bg-hud-red/10 border border-hud-red text-hud-red rounded">
      <ul class="list-disc list-inside">
        <% event.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-hud-text-dim mb-1" %>
      <%= form.text_field :name, required: true, autofocus: true,
          class: "w-full px-3 py-2 hud-input rounded" %>
    </div>

    <div>
      <%= form.label :date, class: "block text-sm font-medium text-hud-text-dim mb-1" %>
      <%= form.date_field :date, required: true,
          class: "w-full px-3 py-2 hud-input rounded" %>
    </div>

    <div>
      <%= form.label :game_system, "Game System", class: "block text-sm font-medium text-hud-text-dim mb-1" %>
      <%= form.select :game_system,
          [["Alpha Strike", "alpha_strike"], ["Classic BattleTech", "classic_bt"]],
          {}, class: "w-full px-3 py-2 hud-select rounded" %>
    </div>

    <div data-themed-event-target="pointCapField">
      <%= form.label :point_cap, "Point Cap", class: "block text-sm font-medium text-hud-text-dim mb-1" %>
      <%= form.number_field :point_cap, required: !event.themed?, min: 1,
          class: "w-full px-3 py-2 hud-input rounded" %>
    </div>
  </div>

  <div>
    <%= form.label :notes, "Additional Rules / Notes", class: "block text-sm font-medium text-hud-text-dim mb-1" %>
    <%= form.text_area :notes, rows: 4,
        placeholder: "Additional rules or notes for this event...",
        class: "w-full px-3 py-2 hud-input rounded" %>
  </div>

  <%# Themed event toggle %>
  <div class="flex items-center gap-2">
    <%= form.check_box :themed, class: "hud-checkbox rounded",
        data: { themed_checkbox: true, action: "themed-event#toggle" } %>
    <%= form.label :themed, "Themed Event", class: "text-sm font-medium text-hud-text-dim" %>
    <span class="text-xs text-hud-text-muted">(Sides with separate point caps and factions)</span>
  </div>

  <%# Shared army list toggle %>
  <div class="flex items-center gap-2">
    <%= form.check_box :shared_army_list, class: "hud-checkbox rounded",
        data: { shared_checkbox: true, action: "themed-event#toggle" } %>
    <%= form.label :shared_army_list, "Shared Army List (co-op)", class: "text-sm font-medium text-hud-text-dim" %>
    <span class="text-xs text-hud-text-muted">(Single list edited collaboratively by all players)</span>
  </div>

  <div data-themed-event-target="sharedTechBaseField" class="<%= "hidden" unless event.shared_army_list? %>">
    <%= form.label :shared_tech_base, "Shared Tech Base", class: "block text-sm font-medium text-hud-text-dim mb-1" %>
    <% current_tech_base = event.shared_tech_base.presence || event.shared_army_list_record&.tech_base || "mixed" %>
    <%= form.select :shared_tech_base,
        ArmyList::TECH_BASES.map { |tb| [ArmyList::TECH_BASES_LABELS[tb], tb] },
        { selected: current_tech_base },
        class: "w-full px-3 py-2 hud-select rounded" %>
    <p class="text-xs text-hud-text-muted mt-1">
      Admin chooses the tech base for shared lists. Players cannot change it.
    </p>
  </div>

  <% if eras.any? %>
    <fieldset>
      <legend class="text-sm font-medium text-hud-text-dim mb-2">Era restrictions (leave empty for no restriction)</legend>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
        <% eras.each do |era| %>
          <label class="flex items-center gap-2 text-sm text-hud-text-dim">
            <input type="checkbox" name="era_ids[]" value="<%= era.mul_id %>"
                   <%= "checked" if event.event_era_restrictions.any? { |r| r.era_mul_id == era.mul_id } %>
                   class="hud-checkbox rounded">
            <%= era.name %>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <%# Faction restrictions — shown when NOT themed %>
  <% if factions.any? %>
    <fieldset data-themed-event-target="factionRestrictions" class="<%= "hidden" if event.themed? %>">
      <legend class="text-sm font-medium text-hud-text-dim mb-2">Faction restrictions (leave empty for no restriction)</legend>
      <div class="grid grid-cols-2 md:grid-cols-3 gap-2 max-h-64 overflow-y-auto border border-hud-border bg-hud-bg rounded p-3">
        <% factions.each do |faction| %>
          <label class="flex items-center gap-2 text-sm text-hud-text-dim">
            <input type="checkbox" name="faction_ids[]" value="<%= faction.mul_id %>"
                   <%= "checked" if event.event_faction_restrictions.any? { |r| r.faction_mul_id == faction.mul_id } %>
                   class="hud-checkbox rounded">
            <%= faction.name %>
          </label>
        <% end %>
      </div>
    </fieldset>
  <% end %>

  <%# Sides editor — shown when themed %>
  <% if factions.any? %>
    <div data-themed-event-target="sidesEditor" class="space-y-4 <%= "hidden" unless event.themed? %>">
      <h3 class="text-sm font-medium text-hud-text-dim uppercase tracking-wider">Sides</h3>

      <% existing_sides = event.event_sides.order(:position).to_a %>
      <% if existing_sides.any? %>
        <% existing_sides.each_with_index do |side, index| %>
          <%= render partial: "admin/events/side_fields", locals: { side: side, index: index, factions: factions } %>
        <% end %>
      <% elsif event.themed? %>
        <%# New themed event — render 2 empty sides %>
        <% 2.times do |index| %>
          <%= render partial: "admin/events/side_fields", locals: { side: nil, index: index, factions: factions } %>
        <% end %>
      <% end %>

      <template data-themed-event-target="sideTemplate">
        <%= render partial: "admin/events/side_fields", locals: { side: nil, index: 0, factions: factions } %>
      </template>

      <div>
        <button type="button"
                data-themed-event-target="addSideButton"
                data-action="themed-event#addSide"
                class="px-3 py-2 hud-btn-primary rounded text-sm cursor-pointer">
          + Add Side
        </button>
      </div>
    </div>
  <% end %>

  <div class="flex gap-3">
    <%= form.submit class: "px-4 py-2 hud-btn-primary rounded cursor-pointer" %>
    <%= link_to "Cancel", admin_events_path,
        class: "px-4 py-2 hud-btn-danger rounded" %>
  </div>
<% end %>
